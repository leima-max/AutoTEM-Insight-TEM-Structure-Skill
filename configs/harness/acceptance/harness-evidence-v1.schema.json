{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autotem:release:harness-evidence:1.0.0",
  "title": "AutoTEM Harness 1.0 evidence contracts",
  "$defs": {
    "id": {"type":"string","pattern":"^[a-f0-9]{32}$"},
    "sha": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "text": {"type":"string","minLength":1},
    "verdict": {"enum":["passed","failed","blocked","not_evaluated"]},
    "artifact": {
      "type":"object","required":["artifact_id","role","kind","step_id","path","sha256","size","execution_usable"],
      "properties":{"artifact_id":{"$ref":"#/$defs/id"},"role":{"$ref":"#/$defs/text"},
        "step_id":{"$ref":"#/$defs/text"},"kind":{"enum":["array","json","image","table","html","pdf"]},
        "size":{"type":"integer","minimum":1},"path":{"$ref":"#/$defs/text"},
        "sha256":{"$ref":"#/$defs/sha"},"execution_usable":{"type":"boolean"},
        "shape":{"type":"array","items":{"type":"integer","minimum":0}},"dtype":{"$ref":"#/$defs/text"},
        "array_sha256":{"$ref":"#/$defs/sha"}},
      "if":{"properties":{"kind":{"const":"array"}}},"then":{"required":["shape","dtype","array_sha256"]}
    },
    "claim": {
      "type":"object","required":["claim","value","artifact_id"],
      "properties":{"claim":{"$ref":"#/$defs/text"},"unit":{"$ref":"#/$defs/text"},
                    "artifact_id":{"$ref":"#/$defs/id"},"value":{"type":["number","array","string"]}},
      "if":{"properties":{"value":{"type":"string"}}},"then":{"required":["limitation"]},"else":{"required":["unit"]}
    },
    "diskCase": {
      "type":"object",
      "required":["case_id","case_verdict","execution_status","user_request","inspection_run_id","run_id","job_id",
                  "parent_run_id","snapshot_sha256","artifacts","claims","report_artifact_id","warnings","scientific_accuracy"],
      "properties":{"case_id":{"$ref":"#/$defs/text"},"case_verdict":{"$ref":"#/$defs/verdict"},
        "execution_status":{"enum":["completed","needs_input","failed","interrupted","cancelled","timed_out"]},
        "user_request":{"$ref":"#/$defs/text"},"run_id":{"$ref":"#/$defs/id"},"inspection_run_id":{"$ref":"#/$defs/id"},
        "job_id":{"$ref":"#/$defs/id"},"parent_run_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
        "snapshot_sha256":{"$ref":"#/$defs/sha"},"artifacts":{"type":"array","items":{"$ref":"#/$defs/artifact"}},
        "claims":{"type":"array","items":{"$ref":"#/$defs/claim"}},"report_artifact_id":{"$ref":"#/$defs/id"},
        "warnings":{"type":"array","items":{"type":"string"}},"scientific_accuracy":{"const":"not_evaluated"}}
    },
    "diskEvidence": {
      "type":"object","required":["schema_version","execution_layer","case_verdict","runtime","cases","fixtures",
        "tool_trace","reliability","operations","started_utc","finished_utc","host_llm_e2e","scientific_accuracy","release_ready"],
      "properties":{"schema_version":{"const":"1.0.0"},"execution_layer":{"const":"local_cli_jsonl"},
        "case_verdict":{"$ref":"#/$defs/verdict"},"cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/diskCase"}},
        "fixtures":{"type":"array","minItems":1},"tool_trace":{"type":"array","minItems":1},
        "runtime":{"type":"object","required":["release_identity","python","platform","skill_resource_sha256"]},
        "host_llm_e2e":{"const":"not_evaluated"},"scientific_accuracy":{"const":"not_evaluated"},"release_ready":{"const":false}}
    },
    "protocolEnvelope": {
      "type":"object","additionalProperties":false,"required":["schema_version","request_id","tool","ok","result","error"],
      "properties":{"schema_version":{"const":"1.0.0"},"request_id":{"type":["string","integer","null"]},
        "tool":{"type":["string","null"]},"ok":{"type":"boolean"},"result":{},"error":{}},
      "if":{"properties":{"ok":{"const":true}}},
      "then":{"properties":{"error":{"type":"null"},"result":{"not":{"type":"null"}}}},
      "else":{"properties":{"result":{"type":"null"},"error":{"type":"object","required":["code","message","retryable"],
        "properties":{"code":{"$ref":"#/$defs/text"},"message":{"$ref":"#/$defs/text"},"retryable":{"type":"boolean"}}}}}
    },
    "requestRecord": {
      "type":"object","required":["request_id","schema_version","run_id","step_id","operation_id","operation_version",
        "fields","reason","evidence_artifact_ids","created","status"],
      "properties":{"request_id":{"$ref":"#/$defs/id"},"run_id":{"$ref":"#/$defs/id"},"schema_version":{"const":"1.0.0"},
        "status":{"enum":["open","answered"]},"created":{"type":"number"},"step_id":{"$ref":"#/$defs/text"},
        "operation_id":{"$ref":"#/$defs/text"},"operation_version":{"$ref":"#/$defs/text"},"reason":{"$ref":"#/$defs/text"},
        "evidence_artifact_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "fields":{"type":"array","minItems":1,"items":{"type":"object","required":["name","answer_schema","answer_options"],
          "properties":{"name":{"$ref":"#/$defs/text"},"answer_schema":{"type":"object"},"answer_options":{"type":"array"}}}}}
    },
    "responseRecord": {
      "type":"object","required":["response_id","request_id","schema_version","parent_run_id","child_run_id",
        "response","validation","adopted_values","created"],
      "properties":{"response_id":{"$ref":"#/$defs/id"},"request_id":{"$ref":"#/$defs/id"},"schema_version":{"const":"1.0.0"},
        "parent_run_id":{"$ref":"#/$defs/id"},"validation":{"type":"object","required":["status"],
          "properties":{"status":{"enum":["accepted","rejected"]}}},"created":{"type":"number"},"adopted_values":{"type":"object"}},
      "if":{"properties":{"validation":{"properties":{"status":{"const":"accepted"}}}}},
      "then":{"properties":{"child_run_id":{"$ref":"#/$defs/id"},"adopted_values":{"minProperties":1},
        "response":{"type":"object","required":["source","basis","answers","request_id"],
          "properties":{"source":{"enum":["user","artifact","metadata"]},"basis":{"$ref":"#/$defs/text"},
             "answers":{"type":"object","minProperties":1},"request_id":{"$ref":"#/$defs/id"}}}}},
      "else":{"properties":{"child_run_id":{"type":"null"},"adopted_values":{"maxProperties":0},"validation":{"required":["code"]}}}
    },
    "hostCase": {
      "type":"object","required":["schema_version","host","case_id","case_verdict","execution_layer","evidence",
        "checks","runs","claims","tool_trace","capture_stage","scientific_accuracy","release_ready"],
      "properties":{"schema_version":{"const":"1.0.0"},"execution_layer":{"const":"real_host_capture"},
        "host":{"enum":["codex","workbuddy","openclaw"]},"case_id":{"pattern":"^J(0[1-9]|1[0-5])$","type":"string"},
        "case_verdict":{"$ref":"#/$defs/verdict"},"capture_stage":{"enum":["not_observed","local_discovery","host_preflight","host_turn"]},
        "evidence":{"type":"object","required":["case_record_sha256","verifier_sha256","matrix_sha256"],
          "properties":{"case_record_sha256":{"$ref":"#/$defs/sha"},"verifier_sha256":{"$ref":"#/$defs/sha"},"matrix_sha256":{"$ref":"#/$defs/sha"}}},
        "scientific_accuracy":{"const":"not_evaluated"},"release_ready":{"const":false},"runs":{"type":"array"},"tool_trace":{"type":"array"},
        "claims":{"type":"array","items":{"type":"object","required":["quote_sha256","artifact_ids"],
          "properties":{"quote_sha256":{"$ref":"#/$defs/sha"},"artifact_ids":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}}}}}},
      "allOf":[{"if":{"properties":{"case_verdict":{"const":"passed"}}},"then":{"required":["host_version","started_at","ended_at","runtime","host_delegation_mode"],
        "properties":{"capture_stage":{"const":"host_turn"},"tool_trace":{"minItems":1},"runtime":{"required":["release_identity","skill_resource_sha256"]},
          "evidence":{"required":["turns","host_version_sha256","adapter_sha256"]},
          "checks":{"required":["host_tool_call","case_execution","answer_return","release_and_resources","effective_tool_permission","session_skill_discovery"]}}}},
        {"if":{"properties":{"case_verdict":{"const":"blocked"}}},"then":{"required":["reason"],"properties":{"evidence":{"required":["blocker_sha256"]}}}}]
    },
    "hostMatrix": {
      "type":"object","required":["schema_version","execution_layer","release_manifest_sha256","release_id","host_versions",
        "hosts","required_variant_counts","scientific_accuracy","release_ready","host_journey_matrix"],
      "properties":{"schema_version":{"const":"1.0.0"},"execution_layer":{"const":"host_evidence_summary_index"},
        "release_manifest_sha256":{"$ref":"#/$defs/sha"},"release_id":{"$ref":"#/$defs/text"},
        "host_journey_matrix":{"$ref":"#/$defs/verdict"},"hosts":{"type":"object","required":["codex","workbuddy","openclaw"]},
        "required_variant_counts":{"type":"object","required":["passed","failed","blocked","not_evaluated"],
          "additionalProperties":{"type":"integer","minimum":0}},"scientific_accuracy":{"const":"not_evaluated"},"release_ready":{"const":false}}
    },
    "certificate": {
      "type":"object","required":["schema_version","gate","case_verdict","release_manifest_sha256","verifier_sha256",
        "probe_sha256","policy_sha256","schema_sha256","checks","release_ready","scientific_accuracy"],
      "properties":{"schema_version":{"const":"1.0.0"},"gate":{"const":"RG0"},"case_verdict":{"$ref":"#/$defs/verdict"},
        "release_manifest_sha256":{"$ref":"#/$defs/sha"},"verifier_sha256":{"$ref":"#/$defs/sha"},
        "probe_sha256":{"$ref":"#/$defs/sha"},"policy_sha256":{"$ref":"#/$defs/sha"},"schema_sha256":{"$ref":"#/$defs/sha"},
        "checks":{"type":"object","minProperties":1,"additionalProperties":{"type":"object","required":["verdict"],
            "properties":{"verdict":{"$ref":"#/$defs/verdict"}}}},
        "scientific_accuracy":{"const":"not_evaluated"},"release_ready":{"const":false}}
    }
  }
}
